# .env.example
# ─────────────────────────────────────────────
#  CrimeTrack-X  |  Environment Configuration
#
#  Copy this file to .env and fill in your values.
#  The .env file should NEVER be committed to source control.
#
#    cp .env.example .env
# ─────────────────────────────────────────────

# MySQL connection
CTX_DB_HOST=localhost
CTX_DB_PORT=3306
CTX_DB_USER=root
CTX_DB_PASSWORD=your_mysql_password_here
CTX_DB_NAME=crimetrack_x

# Django web application. Use a different database name from the console app
# during migration and review; existing schema/data are never overwritten.
CTX_DJANGO_SECRET_KEY=replace-with-a-long-random-value
CTX_DEBUG=1
CTX_ALLOWED_HOSTS=localhost,127.0.0.1
CTX_DB_ENGINE=mysql
CTX_WEB_DB_NAME=crimetrack_x_web
